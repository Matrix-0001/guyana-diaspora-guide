---
interface Props {
  title: string;
}

const { title } = Astro.props;
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(`${title} — ${url}`)}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---

<div class="share-row">
  <span class="share-label">Share this guide:</span>
  <a class="share-btn whatsapp" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
  <a class="share-btn facebook" href={facebookUrl} target="_blank" rel="noopener">Facebook</a>
  <button class="share-btn copy-link" data-url={url}>Copy link</button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-link').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.url || window.location.href);
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = original), 2000);
      } catch {
        btn.textContent = 'Copy failed';
      }
    });
  });
</script>
