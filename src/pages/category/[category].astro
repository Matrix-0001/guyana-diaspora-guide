---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORIES, type CategoryId } from '../../lib/categories';

export async function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const label = CATEGORIES[category as CategoryId];
const articles = (await getCollection('articles', ({ data }) => data.category === category)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title={label} description={`Guides for the Guyanese diaspora: ${label.toLowerCase()}.`}>
  <section class="hero">
    <div class="container">
      <h1>{label}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
      {articles.length === 0 && <p>Guides for this topic are coming soon.</p>}
    </div>
  </section>
</BaseLayout>
