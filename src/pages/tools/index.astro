---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Money Transfer Fee Calculator — Compare Sending Money to Guyana"
  description="Free calculator to compare the real cost of sending money to Guyana across services — fees plus exchange rate markup — and a quick USD to GYD converter."
>
  <section class="hero">
    <div class="container">
      <h1>Remittance Fee Calculator</h1>
      <p>
        Compare what your recipient in Guyana <em>actually gets</em> across services. Enter the fee
        and exchange rate each service quotes you — both change often, so always use today's numbers.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: var(--content-width);">
      <div class="tool-panel">
        <label for="send-amount">Amount you're sending (USD)</label>
        <input type="number" id="send-amount" value="200" min="1" step="1" />

        <table class="fee-table" id="fee-table">
          <thead>
            <tr>
              <th>Service</th>
              <th>Fee (USD)</th>
              <th>Rate (GYD per USD)</th>
              <th>Recipient gets (GYD)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Service A (e.g. Western Union)</td>
              <td><input type="number" class="fee" value="8" min="0" step="0.01" /></td>
              <td><input type="number" class="rate" value="205" min="1" step="0.1" /></td>
              <td class="payout">—</td>
            </tr>
            <tr>
              <td>Service B (e.g. MoneyGram)</td>
              <td><input type="number" class="fee" value="6" min="0" step="0.01" /></td>
              <td><input type="number" class="rate" value="204" min="1" step="0.1" /></td>
              <td class="payout">—</td>
            </tr>
            <tr>
              <td>Service C (e.g. Ria)</td>
              <td><input type="number" class="fee" value="4" min="0" step="0.01" /></td>
              <td><input type="number" class="rate" value="203" min="1" step="0.1" /></td>
              <td class="payout">—</td>
            </tr>
            <tr>
              <td>Bank wire</td>
              <td><input type="number" class="fee" value="35" min="0" step="0.01" /></td>
              <td><input type="number" class="rate" value="206" min="1" step="0.1" /></td>
              <td class="payout">—</td>
            </tr>
          </tbody>
        </table>

        <div class="tool-result" id="best-result">Enter your numbers above to compare.</div>

        <p class="disclaimer">
          The pre-filled fees and rates are <strong>examples only</strong> — replace them with the
          quotes each service shows you today. The official exchange rate hovers around G$208–210
          per US$1, but payout rates differ by service.
        </p>
      </div>

      <h2 class="section-title" style="margin-top: 3rem;">Quick USD → GYD converter</h2>
      <div class="tool-panel">
        <label for="usd-amount">US dollars</label>
        <input type="number" id="usd-amount" value="100" min="0" step="1" />
        <label for="gyd-rate">Exchange rate (GYD per USD)</label>
        <input type="number" id="gyd-rate" value="208.5" min="1" step="0.1" />
        <div class="tool-result" id="convert-result">—</div>
        <p class="disclaimer" id="convert-note">
          Approximate rate pre-filled. Cambios and banks in Guyana quote their own buy/sell rates.
        </p>
      </div>

      <h2 class="section-title" style="margin-top: 3rem;">More tools</h2>
      <div class="card-grid">
        <article class="card">
          <h3><a href="/tools/barrel-shipping-calculator/">Barrel Shipping Cost Calculator</a></h3>
          <p>The all-in, door-to-door cost of shipping a barrel to Guyana — freight, pickup, and clearance.</p>
        </article>
        <article class="card">
          <h3><a href="/tools/visa-wait-estimator/">Family Sponsorship Wait-Time Estimator</a></h3>
          <p>How long sponsoring a spouse, parent, child, or sibling from Guyana really takes.</p>
        </article>
        <article class="card">
          <h3><a href="/convert/">Currency Converter</a></h3>
          <p>USD, CAD, and GBP to Guyanese dollars, with tables for common amounts.</p>
        </article>
      </div>

      <h2 class="section-title" style="margin-top: 3rem;">Related guides</h2>
      <ul>
        <li><a href="/articles/cheapest-way-to-send-money-to-guyana/">The cheapest way to send money to Guyana</a></li>
        <li><a href="/articles/shipping-barrel-to-guyana-cost/">What shipping a barrel to Guyana really costs</a></li>
      </ul>
    </div>
  </section>

  <script>
    function recalc() {
      const amountInput = document.getElementById('send-amount') as HTMLInputElement;
      const amount = parseFloat(amountInput.value) || 0;
      const rows = Array.from(document.querySelectorAll('#fee-table tbody tr'));
      let best: { row: Element; payout: number } | null = null;

      for (const row of rows) {
        const fee = parseFloat((row.querySelector('.fee') as HTMLInputElement).value) || 0;
        const rate = parseFloat((row.querySelector('.rate') as HTMLInputElement).value) || 0;
        const payout = Math.max(0, (amount - fee) * rate);
        (row.querySelector('.payout') as HTMLElement).textContent =
          'G$' + payout.toLocaleString('en-US', { maximumFractionDigits: 0 });
        row.classList.remove('best');
        if (payout > 0 && (!best || payout > best.payout)) best = { row, payout };
      }

      const resultEl = document.getElementById('best-result')!;
      if (best) {
        best.row.classList.add('best');
        const name = best.row.querySelector('td')!.textContent;
        resultEl.innerHTML =
          'Best value: <strong>' + name + '</strong> — recipient gets <strong>G$' +
          best.payout.toLocaleString('en-US', { maximumFractionDigits: 0 }) + '</strong>';
      } else {
        resultEl.textContent = 'Enter your numbers above to compare.';
      }
    }

    function reconvert() {
      const usd = parseFloat((document.getElementById('usd-amount') as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById('gyd-rate') as HTMLInputElement).value) || 0;
      document.getElementById('convert-result')!.innerHTML =
        'US$' + usd.toLocaleString('en-US') + ' ≈ <strong>G$' +
        (usd * rate).toLocaleString('en-US', { maximumFractionDigits: 0 }) + '</strong>';
    }

    document.querySelectorAll('#fee-table input, #send-amount').forEach((el) =>
      el.addEventListener('input', recalc)
    );
    document.querySelectorAll('#usd-amount, #gyd-rate').forEach((el) =>
      el.addEventListener('input', reconvert)
    );
    recalc();
    reconvert();

    // Pull today's live USD→GYD rate into the quick converter.
    fetch('https://open.er-api.com/v6/latest/USD')
      .then((res) => res.json())
      .then((data) => {
        const liveRate = data?.rates?.GYD;
        if (data?.result !== 'success' || !liveRate) return;
        (document.getElementById('gyd-rate') as HTMLInputElement).value = liveRate.toFixed(2);
        reconvert();
        document.getElementById('convert-note')!.textContent =
          `Live mid-market rate pre-filled (G$${liveRate.toFixed(2)} per US$1). ` +
          'Cambios and banks in Guyana quote their own buy/sell rates.';
      })
      .catch(() => {});
  </script>
</BaseLayout>
