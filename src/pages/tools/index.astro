---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOOL_GROUPS, ALL_TOOLS } from '../../lib/tools';
---

<BaseLayout
  title="Free Tools & Calculators for Guyana"
  description="Free calculators for Guyanese at home and abroad — remittance fees, salary and PAYE, vehicle import duty, mortgages, property costs, GPL bills, customs duty, and more."
>
  <section class="hero">
    <div class="container">
      <h1>Tools &amp; Calculators</h1>
      <p>
        {ALL_TOOLS.length} free calculators built on verified GRA, NIS, and agency rates — for
        handling money, property, vehicles, and paperwork in Guyana, whether you live there or abroad.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        TOOL_GROUPS.map(({ group, tools }) => (
          <>
            <h2 class="section-title" style="margin-top: 2rem;">{group}</h2>
            <div class="card-grid">
              {tools.map((tool) => (
                <article class="card">
                  <h3>
                    <a href={tool.href}>{tool.name}</a>
                  </h3>
                  <p>{tool.blurb}</p>
                  <span class="card-more" aria-hidden="true">
                    Open tool <span class="card-more-arrow">→</span>
                  </span>
                </article>
              ))}
            </div>
          </>
        ))
      }

      <h2 class="section-title" style="margin-top: 3rem;">Related guides</h2>
      <ul>
        <li><a href="/articles/cheapest-way-to-send-money-to-guyana/">The cheapest way to send money to Guyana</a></li>
        <li><a href="/articles/shipping-barrel-to-guyana-cost/">What shipping a barrel to Guyana really costs</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
