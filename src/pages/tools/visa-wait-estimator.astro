---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Family Sponsorship Wait-Time Estimator — Guyana to the US"
  description="Estimate how long it takes to sponsor a spouse, parent, child, or sibling from Guyana to the US based on your status and relationship, with current Visa Bulletin context."
>
  <section class="hero">
    <div class="container">
      <h1>Family Sponsorship Wait-Time Estimator</h1>
      <p>
        Pick your status and your relative, and get a realistic picture of the queue — the visa
        category, the typical total wait, and what drives it.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: var(--content-width);">
      <div class="tool-panel">
        <label for="petitioner">Your status</label>
        <select id="petitioner">
          <option value="citizen">US citizen</option>
          <option value="lpr">Green card holder (permanent resident)</option>
        </select>

        <label for="relative">Who you want to sponsor</label>
        <select id="relative">
          <option value="spouse">Spouse</option>
          <option value="parent">Parent</option>
          <option value="minor-child">Unmarried child under 21</option>
          <option value="adult-unmarried">Unmarried child 21 or older</option>
          <option value="adult-married">Married child (any age)</option>
          <option value="sibling">Brother or sister</option>
        </select>

        <div class="tool-result" id="estimate-result">—</div>

        <p class="disclaimer">
          Estimates reflect typical processing plus recent
          <a href="https://travel.state.gov/content/travel/en/legal/visa-law0/visa-bulletin.html" rel="nofollow">Visa Bulletin</a>
          queue movement for most countries (Guyana falls under the "All Chargeability Areas"
          column). Queues speed up and slow down — check the current bulletin for exact dates. This
          is general information, not legal advice.
        </p>
      </div>

      <h2 class="section-title" style="margin-top: 3rem;">Related guides</h2>
      <ul>
        <li><a href="/articles/sponsor-family-member-guyana-to-us/">How to sponsor a family member from Guyana to the US</a></li>
        <li><a href="/articles/us-visa-interview-georgetown-tips/">US visitor visa interview at the Georgetown embassy</a></li>
      </ul>
    </div>
  </section>

  <script>
    const ESTIMATES: Record<string, { category: string; wait: string; note: string } | null> = {
      'citizen-spouse': {
        category: 'Immediate relative (IR-1/CR-1)',
        wait: 'roughly 1–2 years',
        note: 'No visa queue — the wait is petition and embassy processing time only.',
      },
      'citizen-parent': {
        category: 'Immediate relative (IR-5)',
        wait: 'roughly 1–2 years',
        note: 'No visa queue. You must be 21 or older to sponsor a parent.',
      },
      'citizen-minor-child': {
        category: 'Immediate relative (IR-2)',
        wait: 'roughly 1–2 years',
        note: 'No visa queue — processing time only. Child must remain unmarried and under 21 (CSPA protection may apply near the cutoff).',
      },
      'citizen-adult-unmarried': {
        category: 'Family preference F1',
        wait: 'often 7–9 years',
        note: 'Capped category with a queue. If your child marries, the case moves to the slower F3 category.',
      },
      'citizen-adult-married': {
        category: 'Family preference F3',
        wait: 'often 10–13 years',
        note: 'Capped category. Spouse and minor children of your child can immigrate with them as derivatives.',
      },
      'citizen-sibling': {
        category: 'Family preference F4',
        wait: 'often 13–16 years',
        note: 'The longest queue. File as early as possible — the priority date locks in their place in line.',
      },
      'lpr-spouse': {
        category: 'Family preference F2A',
        wait: 'roughly 1–3 years',
        note: 'F2A has been current or near-current in some years — check the bulletin. Naturalizing mid-process upgrades the case to immediate relative.',
      },
      'lpr-minor-child': {
        category: 'Family preference F2A',
        wait: 'roughly 1–3 years',
        note: 'Same category as spouses of green card holders. Naturalizing can speed things up.',
      },
      'lpr-adult-unmarried': {
        category: 'Family preference F2B',
        wait: 'often 6–8 years',
        note: 'If the child marries while you hold a green card, the petition is void — green card holders cannot sponsor married children.',
      },
      'lpr-parent': null,
      'lpr-adult-married': null,
      'lpr-sibling': null,
    };

    const NOT_ELIGIBLE: Record<string, string> = {
      'lpr-parent': 'parents',
      'lpr-adult-married': 'married children',
      'lpr-sibling': 'siblings',
    };

    function update() {
      const petitioner = (document.getElementById('petitioner') as HTMLSelectElement).value;
      const relative = (document.getElementById('relative') as HTMLSelectElement).value;
      const key = `${petitioner}-${relative}`;
      const result = document.getElementById('estimate-result')!;
      const est = ESTIMATES[key];

      if (est) {
        result.innerHTML =
          `Category: <strong>${est.category}</strong><br />` +
          `Typical total wait: <strong>${est.wait}</strong><br />` +
          `<span style="font-size: 0.95rem;">${est.note}</span>`;
      } else {
        result.innerHTML =
          `<strong>Not eligible:</strong> green card holders cannot sponsor ${NOT_ELIGIBLE[key]}. ` +
          'You would need to become a US citizen first, then file in the appropriate category.';
      }
    }

    document.getElementById('petitioner')!.addEventListener('change', update);
    document.getElementById('relative')!.addEventListener('change', update);
    update();
  </script>
</BaseLayout>
