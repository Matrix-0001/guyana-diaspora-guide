---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'How is PAYE calculated in Guyana in 2026?',
    a: 'From your gross pay, the first G$50,000 of monthly overtime is tax-free. NIS (5.6%, capped at G$15,680) is deducted, then your personal allowance — the greater of G$140,000 per month or one-third of your income — plus G$10,000 per child under 18. What remains is chargeable income, taxed at 25% up to G$280,000 per month and 35% above that.',
  },
  {
    q: 'What is the income tax threshold in Guyana for 2026?',
    a: 'The personal allowance is G$140,000 per month (G$1,680,000 per year) or one-third of your income, whichever is greater — so if your only income is a salary of G$140,000 or less, you pay no income tax. The higher 35% rate only applies to chargeable income above G$280,000 per month.',
  },
  {
    q: 'How much NIS do I pay in Guyana?',
    a: 'Employees pay 5.6% of insurable earnings and employers pay 8.4%, on earnings up to the G$280,000 monthly ceiling — so the maximum employee contribution is G$15,680 per month. Self-employed persons pay 12.5%. NIS is deducted before income tax is calculated.',
  },
  {
    q: 'Is overtime taxed in Guyana?',
    a: 'The first G$50,000 of overtime pay each month is tax-free (a statutory allowance, and the same G$50,000 monthly allowance exists for income from a second job). Overtime above that is taxed as normal income.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Guyana Salary & Tax Calculator 2026 — PAYE, NIS & Take-Home Pay"
  description="Calculate your take-home pay in Guyana with 2026 rates — PAYE at the new G$140,000 personal allowance, 25%/35% bands, NIS deductions, overtime and child allowances, plus what you really cost your employer."
>
  <section class="hero">
    <div class="container">
      <a class="hero-back" href="/tools/">← All tools</a>
      <h1>Guyana Salary &amp; Tax Calculator</h1>
      <p>
        Your real take-home pay under the 2026 rules — PAYE, NIS, overtime and child allowances,
        and the total cost to your employer.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="tool-steps" aria-label="How this works">
        <li><span class="step-num">1</span> Enter your basic monthly salary</li>
        <li><span class="step-num">2</span> Add overtime and children if any</li>
        <li><span class="step-num">3</span> See your take-home pay and the full breakdown</li>
      </ol>

      <div class="tool-layout">
        <div class="tool-main">
          <div class="tool-panel">
            <p class="trust-badge">
              ✓ 2026 rates per GRA notice (Income Tax (Amendment) Act No. 3 of 2026, effective 1 Jan 2026) · last checked July 2026
            </p>

            <label for="basic">Basic monthly salary (G$)</label>
        <input type="number" id="basic" value="200000" min="0" step="1000" />

        <label for="overtime">Monthly overtime pay (G$) — first G$50,000 is tax-free</label>
        <input type="number" id="overtime" value="0" min="0" step="1000" />

        <label for="children">Children under 18 (G$10,000 allowance each)</label>
        <input type="number" id="children" value="0" min="0" max="15" step="1" />

          </div>

          <div>
            <h2 class="section-title">How the 2026 calculation works</h2>
      <table class="fee-table">
        <thead><tr><th>Step</th><th>2026 rule</th></tr></thead>
        <tbody>
          <tr><td>Overtime allowance</td><td>First G$50,000/month of overtime is tax-free</td></tr>
          <tr><td>NIS (employee)</td><td>5.6% of earnings up to G$280,000/month (max G$15,680) — deducted before tax</td></tr>
          <tr><td>Personal allowance</td><td>Greater of G$140,000/month or ⅓ of income</td></tr>
          <tr><td>Child allowance</td><td>G$10,000/month per child under 18</td></tr>
          <tr><td>Tax band 1</td><td>25% on chargeable income up to G$280,000/month</td></tr>
          <tr><td>Tax band 2</td><td>35% on chargeable income above G$280,000/month</td></tr>
          <tr><td>NIS (employer)</td><td>8.4% up to the same ceiling (self-employed pay 12.5%)</td></tr>
        </tbody>
      </table>

          </div>

          <div class="faq">
            <h2 class="section-title">Frequently asked questions</h2>
            {
              faqs.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>

        <aside class="tool-aside">
          <div class="result-card" aria-live="polite">
            <span class="result-label">Your take-home pay</span>
            <div id="result-box"></div>
            <div class="share-row" style="margin-top: 1rem;">
              <span class="share-label">Share:</span>
              <a class="share-btn whatsapp" id="share-wa" href="#" target="_blank" rel="noopener">WhatsApp</a>
              <button class="share-btn copy-link" id="share-copy" type="button">Copy link</button>
            </div>
          </div>
          <div class="aside-note">
            Estimate for a single employment using the standard monthly method. Second-job income has
            its own G$50,000 monthly allowance; medical/life insurance premium deductions and other
            reliefs may reduce tax further. Confirm your exact position with the
            <a href="https://gra.gov.gy/tax-services/income-tax/tax-rates-and-thresholds/" rel="nofollow">GRA</a>
            or your payroll department. Source:
            <a href="https://gra.gov.gy/notice-to-employers-employees-self-employed-persons-revised-personal-allowance-and-deductions-for-income-tax-2026/" rel="nofollow">GRA 2026 notice</a>;
            we re-verify after every national budget.
          </div>
          <div class="aside-links">
            <strong>Related</strong>
            <a href="/articles/oil-boom-jobs-guyana-diaspora/">Oil boom jobs in Guyana: a realistic guide</a>
            <a href="/articles/guyana-tax-rules-remigrants/">Guyana tax rules for remigrants</a>
            <a href="/tools/">All tools &amp; calculators</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <div class="ad-slot">Advertisement</div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script>
    // 2026 PAYE rules per GRA notice (Income Tax (Amendment) Act No. 3 of 2026):
    // overtime allowance G$50k/mo; NIS 5.6% capped at ceiling G$280k (deductible);
    // personal allowance max(G$140k, 1/3 of balance); child allowance G$10k;
    // bands 25% <= G$280k chargeable / 35% above. Employer NIS 8.4%.
    const NIS_RATE = 0.056;
    const NIS_EMPLOYER_RATE = 0.084;
    const NIS_CEILING = 280000;
    const OT_ALLOWANCE = 50000;
    const PERSONAL_ALLOWANCE = 140000;
    const CHILD_ALLOWANCE = 10000;
    const BAND1_LIMIT = 280000;

    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const fmt = (n: number) => 'G$' + n.toLocaleString('en-US', { maximumFractionDigits: 0 });
    let lastSummary = '';

    function calculate() {
      const basic = parseFloat($('basic').value) || 0;
      const overtime = parseFloat($('overtime').value) || 0;
      const children = Math.max(0, parseInt($('children').value, 10) || 0);

      const gross = basic + overtime;
      const otExempt = Math.min(overtime, OT_ALLOWANCE);
      const balance = gross - otExempt;
      const nis = NIS_RATE * Math.min(gross, NIS_CEILING);
      const allowance = Math.max(PERSONAL_ALLOWANCE, balance / 3);
      const childAllow = children * CHILD_ALLOWANCE;
      const chargeable = Math.max(0, balance - allowance - nis - childAllow);
      const band1 = Math.min(chargeable, BAND1_LIMIT);
      const band2 = Math.max(0, chargeable - BAND1_LIMIT);
      const tax = 0.25 * band1 + 0.35 * band2;
      const takeHome = gross - nis - tax;
      const employerNis = NIS_EMPLOYER_RATE * Math.min(gross, NIS_CEILING);
      const employerCost = gross + employerNis;

      const rows = [
        ['Gross pay', gross],
        [`Tax-free overtime (first ${fmt(OT_ALLOWANCE)})`, -otExempt],
        ['NIS employee (5.6%, deducted before tax)', -nis],
        [`Personal allowance (${allowance > PERSONAL_ALLOWANCE ? '⅓ of income' : 'G$140,000'})`, -allowance],
        ...(children > 0 ? [[`Child allowance (${children} × G$10,000)`, -childAllow]] : []),
        ['Chargeable income', chargeable],
        ['PAYE at 25%', 0.25 * band1],
        ...(band2 > 0 ? [['PAYE at 35%', 0.35 * band2]] : []),
      ]
        .map(
          ([label, v]) =>
            `<tr><td>${label}</td><td style="text-align:right;">${typeof v === 'number' ? fmt(Math.abs(v)) : v}</td></tr>`
        )
        .join('');

      (document.getElementById('result-box') as HTMLElement).innerHTML = `
        <div class="tool-result">
          Take-home pay: <strong>${fmt(takeHome)}</strong> / month
          <span style="font-size:0.88rem;display:block;">(${fmt(takeHome * 12)} / year)</span>
          <table style="margin-top:0.6rem;">
            <thead><tr><th>Item</th><th style="text-align:right;">Monthly</th></tr></thead>
            <tbody>${rows}</tbody>
          </table>
          <span style="font-size: 0.85rem; display:block; margin-top:0.5rem;">Total deductions: ${fmt(nis + tax)} (NIS ${fmt(nis)} + PAYE ${fmt(tax)}) ·
          Employer's total cost: ${fmt(employerCost)} (incl. ${fmt(employerNis)} employer NIS at 8.4%)</span>
        </div>
      `;

      const params = new URLSearchParams({ basic: String(basic), ot: String(overtime), kids: String(children) });
      history.replaceState(null, '', `${location.pathname}?${params}`);
      lastSummary =
        `Guyana 2026 take-home pay on ${fmt(gross)}/month gross: ${fmt(takeHome)} after NIS (${fmt(nis)}) and PAYE (${fmt(tax)}). ` +
        `Calculate yours: ${location.origin}${location.pathname}?${params}`;
      (document.getElementById('share-wa') as HTMLAnchorElement).href = `https://wa.me/?text=${encodeURIComponent(lastSummary)}`;
    }

    document.getElementById('share-copy')!.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(lastSummary || location.href);
        const btn = document.getElementById('share-copy')!;
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = original), 2000);
      } catch {}
    });

    ['basic', 'overtime', 'children'].forEach((id) => $(id).addEventListener('input', calculate));

    const qp = new URLSearchParams(location.search);
    if (qp.has('basic')) $('basic').value = qp.get('basic')!;
    if (qp.has('ot')) $('overtime').value = qp.get('ot')!;
    if (qp.has('kids')) $('children').value = qp.get('kids')!;

    calculate();
  </script>
</BaseLayout>
