---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Guyana News Today — Latest Headlines from Guyanese Outlets"
  description="A live roundup of the latest Guyana news headlines from Kaieteur News, Demerara Waves, and the Guyana Chronicle — updated automatically. Tap any story to read the full article at the source."
>
  <section class="hero">
    <div class="container">
      <h1>Guyana News</h1>
      <p>
        The latest headlines from Guyana's news outlets, in one place and updated automatically
        through the day. Tap any story to read the full article at the source.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <form class="news-search" id="news-search-form" role="search">
        <input
          type="search"
          id="news-search"
          class="news-search-input"
          placeholder="Search Guyana news headlines…"
          aria-label="Search Guyana news headlines"
          autocomplete="off"
        />
      </form>

      <div class="news-toolbar">
        <div class="news-filters" id="news-filters" role="group" aria-label="Filter by source">
          <button class="news-chip is-active" data-source="all" type="button">All sources</button>
        </div>
        <span class="news-updated" id="news-updated" aria-live="polite"></span>
      </div>

      <div id="news-status" class="news-status">Loading the latest headlines…</div>
      <div id="news-list" class="news-list" hidden></div>

      <p class="news-disclaimer">
        Headlines and short summaries are drawn from each outlet's public feed and remain the work of
        the original publisher — we link to their reporting rather than republish it. For the full
        story, always read it at the source. Search covers a rolling archive that grows toward six
        months from the day it started. Outlets currently included: Kaieteur News, Demerara Waves,
        and the Guyana Chronicle.
      </p>

      <h2 class="section-title" style="margin-top: 3rem;">Popular guides &amp; tools</h2>
      <p style="color: var(--ink-soft); margin: 0 0 1.1rem; font-size: 0.95rem;">
        While you're here — the practical guides and calculators Guyanese use most:
      </p>
      <div class="popular-grid">
        <a class="popular-link" href="/tools/remittance-fee-calculator/">💸 Compare remittance fees</a>
        <a class="popular-link" href="/tools/vehicle-import-calculator/">🚗 Vehicle import duty calculator</a>
        <a class="popular-link" href="/articles/renew-guyana-passport-abroad/">🛂 Passport application &amp; renewal</a>
        <a class="popular-link" href="/tools/barrel-shipping-calculator/">📦 Barrel shipping calculator</a>
        <a class="popular-link" href="/articles/guyana-cost-of-living-2026/">📈 Cost-of-living explainer</a>
        <a class="popular-link" href="/forms/">📄 Download government forms</a>
        <a class="popular-link" href="/tools/salary-calculator/">🧮 Salary &amp; tax calculator</a>
        <a class="popular-link" href="/contacts/">📞 Official contacts &amp; appointments</a>
      </div>
    </div>
  </section>

  <script>
    interface NewsItem {
      title: string;
      link: string;
      source: string;
      published: number | null;
      snippet: string;
    }

    const listEl = document.getElementById('news-list')!;
    const statusEl = document.getElementById('news-status')!;
    const filtersEl = document.getElementById('news-filters')!;
    const updatedEl = document.getElementById('news-updated')!;
    const searchInput = document.getElementById('news-search') as HTMLInputElement;
    const searchForm = document.getElementById('news-search-form') as HTMLFormElement;
    let items: NewsItem[] = [];
    let active = 'all';
    let searching = false;
    let lastUpdatedText = '';

    function timeAgo(ts: number | null): string {
      if (!ts) return '';
      const s = Math.max(0, (Date.now() - ts) / 1000);
      if (s < 3600) return `${Math.max(1, Math.round(s / 60))}m ago`;
      if (s < 86400) return `${Math.round(s / 3600)}h ago`;
      const d = Math.round(s / 86400);
      if (d === 1) return 'yesterday';
      if (d < 7) return `${d}d ago`;
      return new Date(ts).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
    }

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

    // Funnel: when a HEADLINE is clearly about a topic we cover, offer a link to
    // our own guide/tool. Match the title only (snippets are noisy and cause
    // silly false matches), and use specific phrases — a wrong "Related" link is
    // worse than none, so we'd rather show fewer, accurate ones.
    const TOPIC_LINKS: { kw: string[]; label: string; href: string }[] = [
      { kw: ['cost of living', 'cost-of-living', 'inflation', 'food price', 'price of food', 'rising prices', 'cost of food'], label: 'Our cost-of-living explainer', href: '/articles/guyana-cost-of-living-2026/' },
      { kw: ['passport'], label: 'Passport guide & Form A', href: '/articles/renew-guyana-passport-abroad/' },
      { kw: ['remittance', 'western union', 'money transfer', 'moneygram', 'send money home'], label: 'Compare remittance fees', href: '/tools/remittance-fee-calculator/' },
      { kw: ['barrel shipping', 'shipping barrel', 'barrels to guyana'], label: 'Barrel shipping calculator', href: '/tools/barrel-shipping-calculator/' },
      { kw: ['car import', 'vehicle import', 'import duty', 'duty on vehicle', 'used cars', 'motor vehicle duty'], label: 'Vehicle import calculator', href: '/tools/vehicle-import-calculator/' },
      { kw: ['mortgage', 'house lot', 'housing scheme', 'home loan', 'new homes'], label: 'Property & mortgage tools', href: '/tools/mortgage-calculator/' },
      { kw: ['business registration', 'register a business', 'small business', 'starting a business'], label: 'Register a business in Guyana', href: '/articles/register-business-in-guyana/' },
      { kw: ['family sponsorship', 'sponsor family', 'us visa', 'immigrant visa', 'green card'], label: 'Family sponsorship guide', href: '/articles/sponsor-family-member-guyana-to-us/' },
      { kw: ['old age pension', 'nis pension', 'pension increase', 'pensioners'], label: 'NIS pension estimator', href: '/tools/nis-pension-estimator/' },
      { kw: ['gpl', 'electricity', 'blackout', 'power outage', 'power supply'], label: 'GPL bill calculator', href: '/tools/gpl-bill-calculator/' },
      { kw: ['income tax', 'paye', 'minimum wage', 'salary increase', 'wage increase'], label: 'Salary & tax calculator', href: '/tools/salary-calculator/' },
      { kw: ['birth certificate', 'marriage certificate', 'death certificate'], label: 'GRO certificate forms', href: '/articles/guyana-gro-certificates-birth-marriage-death/' },
      { kw: ['fuel price', 'gasoline price', 'price of gas', 'gas price', 'pump price'], label: 'Trip fuel calculator', href: '/tools/trip-fuel-calculator/' },
    ];

    function relatedFor(item: NewsItem) {
      const title = item.title.toLowerCase();
      return TOPIC_LINKS.find((t) => t.kw.some((k) => title.includes(k))) || null;
    }

    function renderList(list: NewsItem[]) {
      listEl.innerHTML = list
        .map((i) => {
          const rel = relatedFor(i);
          return `
        <article class="news-card">
          <div class="news-card-top">
            <span class="news-source">${esc(i.source)}</span>
            <span class="news-time">${timeAgo(i.published)}</span>
          </div>
          <h3 class="news-title"><a href="${esc(i.link)}" target="_blank" rel="noopener nofollow">${esc(i.title)}</a></h3>
          ${i.snippet ? `<p class="news-snippet">${esc(i.snippet)}</p>` : ''}
          <div class="news-card-foot">
            <a class="news-readmore" href="${esc(i.link)}" target="_blank" rel="noopener nofollow">Read at ${esc(i.source)} →</a>
            ${rel ? `<a class="news-related" href="${esc(rel.href)}">${esc(rel.label)} →</a>` : ''}
          </div>
        </article>`;
        })
        .join('');
    }

    function render() {
      const shown = active === 'all' ? items : items.filter((i) => i.source === active);
      if (!shown.length) {
        listEl.innerHTML = '<p class="news-status">No stories to show for this source right now.</p>';
        return;
      }
      renderList(shown);
    }

    function buildFilters(sources: string[]) {
      for (const s of sources) {
        const b = document.createElement('button');
        b.className = 'news-chip';
        b.type = 'button';
        b.dataset.source = s;
        b.textContent = s;
        filtersEl.appendChild(b);
      }
      filtersEl.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.news-chip');
        if (!btn) return;
        if (searching) {
          searching = false;
          searchInput.value = '';
          updatedEl.textContent = lastUpdatedText;
        }
        active = btn.dataset.source!;
        filtersEl.querySelectorAll('.news-chip').forEach((c) => c.classList.toggle('is-active', c === btn));
        render();
      });
    }

    async function load() {
      try {
        const res = await fetch('/api/news-feed');
        if (res.status === 404) {
          statusEl.textContent =
            'The live news feed activates on the published site — it isn’t available in this local preview.';
          return;
        }
        const data = await res.json();
        if (!data.ok || !data.items?.length) {
          statusEl.textContent = 'Couldn’t load the news feed right now — please try again shortly.';
          return;
        }
        items = data.items;
        buildFilters(data.sources || []);
        statusEl.hidden = true;
        listEl.hidden = false;
        render();
        if (data.fetchedAt) {
          lastUpdatedText = 'Updated ' + timeAgo(data.fetchedAt);
          if (!searching) updatedEl.textContent = lastUpdatedText;
        }
      } catch {
        statusEl.textContent = 'Couldn’t load the news feed right now — please check your connection and try again.';
      }
    }

    // Search the rolling archive (server-side, over the last 6 months as it grows).
    async function doSearch(q: string) {
      searching = true;
      updatedEl.textContent = 'Searching…';
      statusEl.hidden = true;
      listEl.hidden = false;
      try {
        const res = await fetch('/api/news-feed?q=' + encodeURIComponent(q));
        const data = await res.json();
        const results: NewsItem[] = data.items || [];
        if (!results.length) {
          listEl.innerHTML = `<p class="news-status">No headlines found for “${esc(q)}”. The searchable archive is still building up — try a shorter term, or check back as it grows.</p>`;
          updatedEl.textContent = '0 results';
          return;
        }
        renderList(results);
        updatedEl.textContent = `${results.length} result${results.length === 1 ? '' : 's'} for “${q}”`;
      } catch {
        listEl.innerHTML = '<p class="news-status">Search is unavailable right now — please try again shortly.</p>';
      }
    }

    function exitSearch() {
      if (!searching) return;
      searching = false;
      updatedEl.textContent = lastUpdatedText;
      render();
    }

    let debounceId = 0;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const q = searchInput.value.trim();
        window.clearTimeout(debounceId);
        if (q.length < 2) {
          exitSearch();
          return;
        }
        debounceId = window.setTimeout(() => doSearch(q), 400);
      });
      searchForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = searchInput.value.trim();
        if (q.length >= 2) doSearch(q);
      });
    }

    load();
  </script>
</BaseLayout>
