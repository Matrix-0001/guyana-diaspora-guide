---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { CATEGORIES } from '../lib/categories';
import { TOOL_GROUPS } from '../lib/tools';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const currentPath = Astro.url.pathname;
const ogImage = Astro.site ? new URL('/og-image.png', Astro.site).href : '/og-image.png';

// Google Analytics 4 — loads in production only (never in local dev, so dev
// traffic doesn't pollute the data). The measurement ID isn't secret (it ships
// in the client HTML), so it's baked in here; a PUBLIC_GA_MEASUREMENT_ID env
// var overrides it if ever needed.
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-RTX673PKCF';
const gaEnabled = import.meta.env.PROD && GA_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Guyana Diaspora Guide</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Guyana Diaspora Guide" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {
      gaEnabled && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`}
          />
        </>
      )
    }
    <!-- Google AdSense script goes here once the site is approved -->
  </head>
  <body>
    <header class="site-header">
      <div class="flag-bar"></div>
      <div class="read-progress" aria-hidden="true"></div>
      <div class="header-inner">
        <a class="site-logo" href="/">Guyana <span>Diaspora</span> Guide</a>
        <nav class="site-nav" aria-label="Main navigation">
          {
            Object.entries(CATEGORIES).map(([id, label]) => (
              <a href={`/category/${id}/`} aria-current={currentPath === `/category/${id}/` ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
          <div class="nav-dropdown">
            <a
              href="/tools/"
              class="nav-dropdown-trigger"
              aria-current={currentPath.startsWith('/tools/') ? 'page' : undefined}
              aria-haspopup="true"
            >
              Tools
              <svg class="nav-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                <path d="M1 3.5 5 7.5 9 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <div class="nav-dropdown-menu" role="menu">
              {
                TOOL_GROUPS.map(({ group, tools }) => (
                  <div class="nav-dropdown-group">
                    <span class="nav-dropdown-label">{group}</span>
                    {tools.map((tool) => (
                      <a href={tool.href} role="menuitem" aria-current={currentPath === tool.href ? 'page' : undefined}>
                        {tool.name}
                      </a>
                    ))}
                  </div>
                ))
              }
              <a class="nav-dropdown-all" href="/tools/" role="menuitem">All tools →</a>
            </div>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-links">
          <a href="/about/">About</a>
          <a href="/forms/">Forms</a>
          <a href="/contacts/">Official Contacts</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/terms/">Terms of Use</a>
        </div>
        <p class="fine-print">
          Guyana Diaspora Guide provides general information for Guyanese living abroad. It is not
          legal, financial, or immigration advice. Fees, exchange rates, and government requirements
          change often — always confirm details with the official agency or provider before acting.
        </p>
        <p class="fine-print">
          &copy; {new Date().getFullYear()} Guyana Diaspora Guide. Built by
          <a href="/contact/">Savanna Studios</a> — web design &amp; development.
        </p>
      </div>
    </footer>

    <script>
      // Subtle scroll-reveal on cards, panels, and tables; respects reduced motion.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && 'IntersectionObserver' in window) {
        const targets = document.querySelectorAll(
          '.card, .tool-panel, .tool-card, .tool-aside > *, .faq details, .prose .fee-table, .section .fee-table, .prose > h2'
        );
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).classList.add('in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -5% 0px' }
        );
        targets.forEach((el, i) => {
          el.classList.add('reveal');
          (el as HTMLElement).style.transitionDelay = `${Math.min((i % 6) * 55, 275)}ms`;
          io.observe(el);
        });
        // Fail-safe: never leave content hidden if observers don't fire
        // (old browsers, throttled webviews, reader modes).
        setTimeout(() => {
          document.querySelectorAll('.reveal:not(.in)').forEach((el) => el.classList.add('in'));
        }, 1800);
      }

      // Pulse the result card whenever a tool writes a new result into it.
      if (!reduced) {
        document.querySelectorAll('.result-card').forEach((card) => {
          let queued = false;
          new MutationObserver(() => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              card.classList.remove('result-pulse');
              // Force a reflow so re-adding the class restarts the animation.
              void (card as HTMLElement).offsetWidth;
              card.classList.add('result-pulse');
              queued = false;
            });
          }).observe(card, { childList: true, characterData: true, subtree: true });
        });
      }

      // Reading progress bar under the sticky header.
      const progress = document.querySelector('.read-progress') as HTMLElement | null;
      if (progress) {
        let ticking = false;
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.transform = `scaleX(${max > 60 ? Math.min(window.scrollY / max, 1) : 0})`;
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true }
        );
        update();
      }
    </script>
  </body>
</html>
